{
  "name": "douyin-article-publisher-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "start": "electron .",
    "prepare-browser": "node scripts/install-browser.mjs",
    "dist:win": "npm run prepare-browser && electron-builder --win nsis"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.879.0",
    "playwright": "^1.60.0"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.douyin.articlepublisher",
    "productName": "抖音文章发布器",
    "asar": true,
    "asarUnpack": [
      "node_modules/playwright-core/**"
    ],
    "files": [
      "src/**/*",
      "scripts/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/playwright-core/.local-browsers",
        "to": "pw-browsers",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
