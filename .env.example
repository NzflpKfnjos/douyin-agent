# S3-compatible OSS settings. For Alibaba Cloud OSS, use an S3-compatible endpoint
# or a compatible gateway. S3_PUBLIC_BASE_URL should be the public CDN/bucket URL.
S3_BUCKET=
S3_ENDPOINT=https://s3.example.com
S3_REGION=auto
# The uploader accepts these Rainyun-style names (or the canonical *_ID/*_URL names).
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE=
S3_KEY_PREFIX=douyin
S3_FORCE_PATH_STYLE=false

# Optional browser settings
DOUYIN_CREATOR_URL=https://creator.douyin.com/creator-micro/content/upload
DOUYIN_BROWSER_DATA_DIR=.douyin-browser
# Optional: default topic tag (no # needed). Defaults to 暗区突围.
# DOUYIN_TOPIC_TAG=暗区突围
# Optional: path to a Chrome/Edge executable if auto-detect fails.
# Windows example: C:\Program Files\Google\Chrome\Application\chrome.exe
# macOS example:   /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# DOUYIN_BROWSER_EXECUTABLE_PATH=
